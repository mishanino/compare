# Copy to .env and fill in. Never commit .env.

# Vision provider. Only "gemini" is implemented.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Any model id that supports generateContent with images, e.g. gemini-3.8-flash
GEMINI_MODEL_ID=

# Standard paid-tier prices per 1M tokens for GEMINI_MODEL_ID, from
# https://ai.google.dev/gemini-api/docs/pricing (output includes thinking tokens).
# Leave empty and the cost is logged as null instead of being guessed.
PRICE_INPUT_PER_MTOK_USD=
PRICE_OUTPUT_PER_MTOK_USD=

# Optional per-model prices, used by `npm run eval -- --model <id>`.
# Suffix = model id upper-cased, non-alphanumerics replaced by "_".
# PRICE_INPUT_PER_MTOK_USD__GEMINI_3_5_FLASH_LITE=
# PRICE_OUTPUT_PER_MTOK_USD__GEMINI_3_5_FLASH_LITE=

# Optional: where each run appends its JSON line (default runs/log.jsonl).
# RUN_LOG_PATH=
