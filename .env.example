# Copy to .env and fill in. Never commit .env.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# Any model id that supports generateContent with images, e.g. gemini-3.8-flash
GEMINI_MODEL_ID=
# Standard paid-tier prices per 1M tokens (output includes thinking tokens)
PRICE_INPUT_PER_MTOK_USD=
PRICE_OUTPUT_PER_MTOK_USD=
# Optional per-model prices, used by `npm run eval -- --model <id>`.
# Suffix = model id upper-cased, non-alphanumerics replaced by "_".
# PRICE_INPUT_PER_MTOK_USD__GEMINI_3_5_FLASH_LITE=
# PRICE_OUTPUT_PER_MTOK_USD__GEMINI_3_5_FLASH_LITE=
